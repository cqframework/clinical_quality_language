{
  "name": "@cqframework/cql",
  "version": "${version}",
  "description": "JavaScript tools for the Clinical Quality Language (CQL).",
  "keywords": [
    "cql",
    "clinical quality language"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqframework/clinical_quality_language.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./cql": {
      "types": "./engine.d.mts",
      "default": "./cql.mjs"
    },
    "./cql-to-elm": {
      "types": "./engine.d.mts",
      "default": "./cql-to-elm.mjs"
    },
    "./elm": {
      "types": "./engine.d.mts",
      "default": "./elm.mjs"
    },
    "./engine": {
      "types": "./engine.d.mts",
      "default": "./engine.mjs"
    },
    "./shared": {
      "types": "./engine.d.mts",
      "default": "./shared.mjs"
    }
  },
  "dependencies": {
    "@js-joda/timezone": "2.23.0",
    "@js-joda/core": "3.2.0",
    "saxes": "6.0.0"
  }
}
